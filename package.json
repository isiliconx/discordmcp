{
  "name": "discordmcp",
  "version": "1.0.0",
  "description": "Discord MCP server with a complete public REST catalog, experimental user-token mode, and Gateway tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "discordmcp": "dist/index.js" },
  "engines": { "node": ">=22" },
  "files": ["dist", "data", "vendor", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test && npm run catalog:check",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "smoke:live": "npm run build && node scripts/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isiliconx/discordmcp.git"
  },
  "keywords": ["discord", "mcp", "model-context-protocol", "ai"],
  "author": "isiliconx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isiliconx/discordmcp/issues"
  },
  "homepage": "https://github.com/isiliconx/discordmcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
