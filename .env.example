# user = experimental raw account token; bot = Bot token; oauth = OAuth2 bearer token
DISCORD_AUTH_TYPE=user
DISCORD_TOKEN=
# full advertises every operation; compact keeps every operation accessible through discord_call.
MCP_TOOL_MODE=full
# Optional server-enforced protection: blocks API writes and application Gateway commands.
MCP_READ_ONLY=false
# Optional Gateway intents for bot mode. Enable required privileged intents in Discord.
DISCORD_GATEWAY_INTENTS=0
# Persistent observed-message archive. Setup enables this; manual configurations opt in.
MCP_ARCHIVE_ENABLED=false
# Optional absolute SQLite path, inside a private 0700 directory. Defaults to local account-specific data.
# MCP_ARCHIVE_PATH=/absolute/private/path/messages.sqlite
# Automatically connect while the MCP is running. Use false with a dedicated background recorder.
MCP_ARCHIVE_AUTOCONNECT=true
# Always-on outgoing request pacing in milliseconds. Zero-delay operation is rejected.
MCP_MIN_REQUEST_INTERVAL_MS=2000
MCP_MIN_WRITE_INTERVAL_MS=6000
MCP_PACING_JITTER_MS=500
# Optional shared private SQLite path; defaults to a per-credential local data directory.
# MCP_PACING_PATH=/absolute/private/path/pacing.sqlite
# HTTP mode requires a separate secret. Generate with: openssl rand -hex 32
MCP_HTTP_TOKEN=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Comma-separated exact HTTP Host headers and browser origins if using a reverse proxy.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
